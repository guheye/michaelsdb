# Copy to .env.local and fill in values. Never commit .env.local.

# Required for AI headline rewriting (Anthropic API).
ANTHROPIC_API_KEY=

# Optional: Unsplash API key for backfilling article images when sources lack OG images.
UNSPLASH_ACCESS_KEY=

# Optional: absolute path to the SQLite database file (production: mount a persistent disk and point here).
# SQLITE_PATH=/var/data/michaelsdb.db

# Required: password that guards POST /api/aggregate. Set a strong random value in production.
# Generate one with: openssl rand -hex 32
AGGREGATE_SECRET=

# Optional: rate limits for fetching (defaults shown).
# AGGREGATE_COOLDOWN_MS=60000
# FEED_FETCH_GAP_MS=750
# OG_SCRAPE_GAP_MS=400
# UNSPLASH_GAP_MS=1200
